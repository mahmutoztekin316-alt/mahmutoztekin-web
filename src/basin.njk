---js
{
  layout: "base.njk",
  dil: "tr",
  title: "Basın",
  // Bu sayfa yalnızca Site ayarları › Menü'de "Göster" açıksa yayınlanır.
  eleventyComputed: {
    permalink: (data) => ((data.ayarlar && data.ayarlar.menu) || []).some((m) => m.adres === "/basin/" && m.goster) ? "/basin/" : false
  }
}
---
<h1 class="sayfa-baslik">Basın</h1>
<div class="kaydir" tabindex="0">
<section class="liste tek">
  <ul>
  {% for b in basin.baglantilar %}
    <li><span><a href="{{ b.url }}" rel="noopener">{{ b.ad }}</a>{% if b.aciklama %}<br><small>{{ b.aciklama }}</small>{% endif %}</span></li>
  {% endfor %}
  </ul>
</section>
</div>
