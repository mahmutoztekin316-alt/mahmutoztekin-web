---
layout: base.njk
title: Eserler
dil: tr
karsi: /en/works/
---
{% set dil = dil or "tr" %}{% set t = i18n[dil] %}
<h1 class="sayfa-baslik">{{ t.eserler }}</h1>
<div class="kaydir seritler" tabindex="0">
{% for g in collections.eserler | yillar %}
<section class="serit" aria-labelledby="y{{ g.yil }}">
  <h2 id="y{{ g.yil }}">{{ g.yil }}</h2>
  <div class="serit-icerik" tabindex="0">
    {% for v in videolar.videolar %}{% if v.yil == g.yil %}{% set va = v.aciklama_en if (dil == "en" and v.aciklama_en) else v.aciklama %}
    <figure class="kart video-kart">
      <video src="{{ v.dosya }}" poster="{{ v.kapak }}" controls muted playsinline preload="none" aria-label="{{ va }}"></video>
      <figcaption>{{ va }}</figcaption>
    </figure>
    {% endif %}{% endfor %}
    {% for e in g.eserler %}
    <a class="kart" href="{{ e | enUrl if dil == 'en' else e.url }}">
      <img src="{{ e.data.gorsel }}" alt="" loading="lazy">
      <span>{{ e.data.title_en if (dil == "en" and e.data.title_en) else e.data.title }}</span>
    </a>
    {% endfor %}
  </div>
</section>
{% endfor %}
</div>
