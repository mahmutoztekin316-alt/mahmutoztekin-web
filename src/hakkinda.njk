---
layout: base.njk
title: Hakkında
govde_sinifi: hakkinda-sayfa
---
<div class="hakkinda">
  <div class="portre-kutu"><img class="portre" src="{{ hakkinda.portre }}" alt="Mahmut Öztekin"></div>
  <div class="hakkinda-sag">
    <div class="baslik-satir">
      <h1 class="sayfa-baslik">Hakkında</h1>
      <a class="cv" href="{{ hakkinda.cv }}" download>CV <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.8 8 10.3l3.5-3.5M2.5 11.5v2h11v-2"/></svg><span class="gizli"> (PDF indir)</span></a>
    </div>
    <div class="kaydir metin" tabindex="0">
      {{ hakkinda.biyografi | paragraflar | safe }}
      <hr class="ayrac">
      {{ hakkinda.sanatci_metni | paragraflar | safe }}
    </div>
  </div>
</div>
