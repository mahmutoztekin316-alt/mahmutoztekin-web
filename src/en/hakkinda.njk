---
layout: base.njk
title: About
dil: en
karsi: /hakkinda/
permalink: /en/about/
govde_sinifi: hakkinda-sayfa
---
{% set dil = dil or "tr" %}{% set t = i18n[dil] %}
<div class="hakkinda">
  <div class="portre-kutu"><img class="portre" src="{{ hakkinda.portre }}" alt="Mahmut Öztekin"></div>
  <div class="hakkinda-sag">
    <div class="baslik-satir">
      <h1 class="sayfa-baslik">{{ t.hakkinda }}</h1>
      <a class="cv" href="{{ hakkinda.cv_en if (dil == 'en' and hakkinda.cv_en) else hakkinda.cv }}" download>{{ t.cv }} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.8 8 10.3l3.5-3.5M2.5 11.5v2h11v-2"/></svg><span class="gizli">{{ t.cv_gizli }}</span></a>
    </div>
    <div class="kaydir metin" tabindex="0">
      {{ (hakkinda.biyografi_en if dil == "en" else hakkinda.biyografi) | paragraflar | safe }}
      <div class="bosluk"></div>
      {{ (hakkinda.sanatci_metni_en if dil == "en" else hakkinda.sanatci_metni) | paragraflar | safe }}
    </div>
  </div>
</div>
