{% set dil = dil or "tr" %}{% set t = i18n[dil] %}<!doctype html>
<html lang="{{ dil }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="google-site-verification" content="PpzqhNqoF54v34z7I2dp9T4CI0CsesDN6P3OywGJH38">
<title>{% if title and page.url != "/" and page.url != "/en/" %}{{ title }} · {% endif %}{{ ayarlar.site_adi }}</title>
<meta name="description" content="{{ aciklama or t.aciklama }}">
<meta property="og:title" content="{{ title or ayarlar.site_adi }}">
<meta property="og:description" content="{{ aciklama or t.aciklama }}">
<meta property="og:image" content="{{ ayarlar.site_url }}{{ gorsel or "/assets/eserler/senin-bahcende-buyuyen-bir-yabaniyim.jpg" }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ ayarlar.site_url }}{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">
{% if karsi %}<link rel="alternate" hreflang="{{ 'en' if dil == 'tr' else 'tr' }}" href="{{ ayarlar.site_url }}{{ karsi }}">{% endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;1,400&display=swap">
<link rel="stylesheet" href="/assets/stil.css">
{% if ayarlar.istatistik_kodu %}<script data-goatcounter="https://{{ ayarlar.istatistik_kodu }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>{% endif %}
</head>
<body class="{{ govde_sinifi }}">
<a class="atla" href="#icerik">{{ t.atla }}</a>
<header class="ust">
  <a class="isim" href="{{ '/en/' if dil == 'en' else '/' }}">{{ ayarlar.site_adi }}</a>
  <div class="ust-sag">
    <a class="dil" href="{{ karsi or ('/' if dil == 'en' else '/en/') }}" lang="{{ 'en' if dil == 'tr' else 'tr' }}" hreflang="{{ 'en' if dil == 'tr' else 'tr' }}" aria-label="{{ t.dil_etiket }}">{{ t.dil }}</a>
    <button class="menu-dugme" type="button" aria-expanded="false" aria-controls="menu">{{ t.menu }}</button>
  </div>
  <nav id="menu" class="menu" aria-label="Menu">
    {% for m in ayarlar.menu %}{% if m.goster %}{% set adres = m.adres_en if dil == 'en' else m.adres %}<a href="{{ adres }}"{% if page.url and page.url.startsWith(adres) %} aria-current="page"{% endif %}>{{ m.ad_en if dil == 'en' else m.ad }}</a>{% endif %}{% endfor %}
  </nav>
</header>
<main id="icerik">
{{ content | safe }}
</main>
<footer class="alt">
  <div class="bant" aria-hidden="true"></div>
  <div class="alt-satir">
    <span>© Mahmut Öztekin</span>
    <span><a href="mailto:{{ ayarlar.eposta }}">{{ ayarlar.eposta }}</a> · <a href="{{ ayarlar.instagram }}" rel="noopener">Instagram</a></span>
  </div>
</footer>
<script>
const d=document.querySelector('.menu-dugme'),n=document.getElementById('menu');
d.addEventListener('click',()=>{const a=d.getAttribute('aria-expanded')==='true';d.setAttribute('aria-expanded',String(!a));n.classList.toggle('acik',!a);});
</script>
</body>
</html>
